name: Membrowse - Memory reports
on:
  pull_request:
  push:
    branches:
      - main
jobs:
  setup-environment:
    runs-on: ubuntu-latest
    outputs:
      pio-version: ${{ steps.get-version.outputs.version }}
      python-version: ${{ steps.setup-python-step.outputs.python-version }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v7
        with:
          fetch-depth: 2                 # parent commit, for the diff

      - name: Set up Python
        uses: actions/setup-python@v7
        id: setup-python-step
        with:
          python-version: "3.x"

      # Fetch the latest available PlatformIO version from PyPI
      - name: Get PlatformIO version
        id: get-version
        
        run: |
          # Use pip index to get versions and extract the latest one using grep/sed
          PIO_VER=$(pip index versions platformio | grep -E "Available versions:" | sed -E 's/Available versions: //g' | awk -F', ' '{print $1}')
          echo "PlatformIO Version: $PIO_VER"
          echo "version=$PIO_VER" >> $GITHUB_OUTPUT
        
      - name: Create and Cache Virtual Environment
        id: cache-venv
        uses: actions/cache@v6
        with:
          path: .venv
          # Uses the file hash of requirements.txt to uniquely identify this environment
          key: ${{ runner.os }}-venv-${{ steps.setup-python-step.outputs.python-version }}-pio-${{ steps.get-version.outputs.version }}

      - name: Install dependencies (only runs if cache misses)
        if: steps.cache-venv.outputs.cache-hit != 'true'
        run: |
          python -m venv .venv
          source .venv/bin/activate
          pip install --upgrade pip
          pip install platformio

  process-targets:
    needs: setup-environment
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false 
      matrix:
        include:
          - target: ZuluSCSI_Blaster
          - target: ZuluSCSI_Wide
          - target: ZuluSCSI_RP2040
          - target: ZuluSCSI_Pico
          - target: ZuluSCSI_Pico_DaynaPORT
          - target: ZuluSCSI_Pico_2
          - target: ZuluSCSI_Pico_2_DaynaPORT
    outputs:
      pio-version: ${{ steps.re-get-version.outputs.version }}
      python-version: ${{ steps.re-setup-python-step.outputs.python-version }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v7
        with:
          fetch-depth: 2                 # parent commit, for the diff

      - name: Set up Python
        id: re-setup-python-step
        uses: actions/setup-python@v7
        with:
          python-version: "3.x"

      # Fetch the latest available PlatformIO version from PyPI again - this is in case platformio gets update between the setup-environment job and this job
      - name: Get PlatformIO version
        id: re-get-version

        run: |
          # Use pip index to get versions and extract the latest one using grep/sed
          PIO_VER=$(pip index versions platformio | grep -E "Available versions:" | sed -E 's/Available versions: //g' | awk -F', ' '{print $1}')
          echo "PlatformIO Version: $PIO_VER"
          echo "version=$PIO_VER" >> $GITHUB_OUTPUT

      - name: Load Shared PlatformIO Environment
        id: failed-cache-venv
        uses: actions/cache@v6
        with:
          path: .venv
          key: ${{ runner.os }}-venv-${{ steps.re-setup-python-step.outputs.python-version }}-pio-${{ steps.re-get-version.outputs.version }}

      - name: Reinstall dependencies (only runs if cache misses)
        if: steps.failed-cache-venv.outputs.cache-hit != 'true'
        run: |
          python -m venv .venv
          source .venv/bin/activate
          pip install --upgrade pip
          pip install platformio

      - name: Run PlatformIO for RP2040 and RP2350 MCU targets
        run: |
          source .venv/bin/activate
          pio run -e "${{ matrix.target }}"
      - uses: membrowse/membrowse-action@v1
        with:
          elf: ".pio/build/${{ matrix.target }}/firmware.elf"
          target_name: ${{ matrix.target }}
          api_key: ${{ secrets.MEMBROWSE_API_KEY }}
          ld:     ".pio/build/${{ matrix.target }}/rp_linker.ld"
          map_file: ".pio/build/${{ matrix.target }}/zuluscsi.map"  # optional: per-library attribution
          skip_sections: ".heap"


